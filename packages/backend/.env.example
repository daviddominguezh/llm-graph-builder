# Env
PRODUCTION=false

# Server
PORT=4000

# Local Supabase (these values work with default `supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MjA4OTY2NDQ1MX0.A4VKOdSCGuWLXLnUgLLGF2Uz4kL_hikN-hht1Rvq39E
SUPABASE_EDGE_FUNCTION_URL=http://127.0.0.1:54321/functions/v1
# Base URL the RAG store service uses to reach the backend's own master-key-gated
# /internal router (embed + rerank). Defaults to http://127.0.0.1:3001 if unset.
BACKEND_INTERNAL_URL=http://127.0.0.1:4000
OAUTH_CALLBACK_URL=http://localhost:4000/mcp/oauth/callback
WEB_URL=http://localhost:3101

# Generate these yourself
JWT_SECRET=<random-secret-for-signing-oauth-state>
TOKEN_ENCRYPTION_KEY=<64-char-hex-string>
EDGE_FUNCTION_MASTER_KEY=<generate-with-openssl-rand-base64-32>

# Redis: Upstash (cache only — credentials, media uploads)
UPSTASH_REDIS_REST_URL=<your-upstash-redis-rest-url>
UPSTASH_REDIS_REST_TOKEN=<your-upstash-redis-rest-token>

# Redis Cloud (pub/sub, locking, rate limiting, notifications)
REDIS_URL=redis://default:<password>@<host>:<port>

# Messaging: WhatsApp
WHATSAPP_APP_SECRET=<your-whatsapp-app-secret>
WHATSAPP_VERIFY_TOKEN=<your-whatsapp-verify-token>

# Messaging: Instagram
INSTAGRAM_APP_SECRET=<your-instagram-app-secret>
INSTAGRAM_VERIFY_TOKEN=<your-instagram-verify-token>

# Messaging: Auth
MESSAGING_MASTER_API_KEY=<your-messaging-api-key>

# Meta/Facebook App (WhatsApp Business)
FB_APP_ID=<your-fb-app-id>
FB_APP_SECRET=<your-fb-app-secret>
FB_APP_PIN=<your-fb-app-pin>

# Open Router
OPENROUTER_MANAGEMENT_KEY=<your_openrouter_management_key>

# GitHub App (for VFS GitHub integration)
GITHUB_APP_ID=
GITHUB_APP_NAME=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# Mock execute (development only — never enable in production)
ENABLE_MOCK_EXECUTE=true

# Fly.io internal DNS membership (multi-machine MCP connection routing).
# Injected automatically by the Fly runtime; set manually only for local
# testing of the consistent-hash ring. FLY_APP_NAME selects the
# `vms.<app>.internal` TXT lookup; FLY_MACHINE_ID is this instance's id.
FLY_APP_NAME=
FLY_MACHINE_ID=

# Triggers (scheduled agent runs)
# Adapter selection: PRODUCTION=true uses Google Cloud Tasks; otherwise an
# in-process local timer (dev only — not durable/multi-instance-safe).
# Cloud Tasks (required when PRODUCTION=true):
GCP_PROJECT_ID=<your-gcp-project-id>
CLOUD_TASKS_LOCATION=<queue-region-e.g-us-central1>
CLOUD_TASKS_QUEUE=agent-triggers
# Public URL Cloud Tasks POSTs each fire to (must be reachable from Google):
TRIGGER_FIRE_URL=http://localhost:4000/internal/triggers/fire
# REQUIRED — userId for every trigger run; must be non-empty or runs fail validation:
TRIGGER_DEFAULT_USER_ID=<system-user-uuid>
# Optional tuning (defaults shown — omit unless overriding):
# TRIGGER_JITTER_WINDOW_MS=0
# TRIGGER_MAX_HORIZON_MS=1728000000   # 20 days (< Cloud Tasks 30d & setTimeout ~24.8d ceilings)
# TRIGGER_EXEC_TIMEOUT_MS=600000      # 10 min
